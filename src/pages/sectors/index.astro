---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import SectorCard from '../../components/SectorCard.astro';
import { getCollection } from 'astro:content';
import { buildBreadcrumbs, breadcrumbSchema } from '../../utils/breadcrumbs';
import { MEDIA } from '../../utils/media';
import { SITE } from '../../consts';

const sectors = (await getCollection('sectors')).sort((a, b) => a.data.order - b.data.order);
const breadcrumbs = buildBreadcrumbs([{ label: 'Sectors' }]);
const schema = [breadcrumbSchema(breadcrumbs, SITE.url)];
---

<BaseLayout
  title="Sector Cleaning Services Ireland | Ryak Cleaning"
  description="Specialist cleaning for data centres, food production, healthcare, education and more across Ireland. Call 01 531 4044."
  breadcrumbs={breadcrumbs}
  breadcrumbInHero
  schema={schema}
>
  <PageHero
    eyebrow="Sectors"
    title="Specialist cleaning for Ireland's most demanding environments"
    description="Every sector has its own compliance regime. Our teams are trained, vetted and equipped for each one."
    imageSrc={MEDIA.hero.sectors}
    imageAlt="Sector specialist cleaning across Ireland"
    breadcrumbs={breadcrumbs}
    compact
  />

  <section class="py-16">
    <div class="wrap grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-3.5">
      {
        sectors.map((sector, i) => (
          <SectorCard
            title={sector.data.title}
            description={sector.data.description}
            href={`/sectors/${sector.slug}/`}
            index={i + 1}
            featured={sector.data.featured}
            tag={sector.data.featured ? 'Featured' : undefined}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
