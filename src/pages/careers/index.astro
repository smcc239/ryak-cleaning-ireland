---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import Button from '../../components/Button.astro';
import { buildBreadcrumbs } from '../../utils/breadcrumbs';
---

<BaseLayout
  title="Careers at Ryak Cleaning Ireland"
  description="Join Ryak Cleaning Ireland. Directly employed cleaning operatives and specialist roles across Dublin and nationwide."
  breadcrumbs={buildBreadcrumbs([{ label: 'Careers' }])}
>
  <section class="py-16 bg-stone">
    <div class="wrap max-w-3xl">
      <SectionHead
        eyebrow="Careers"
        title="Work with an accredited Irish cleaning company"
        lead="Ryak employs trained, vetted cleaning operatives directly. We invest in training, equipment and career development."
      />
    </div>
  </section>

  <section class="py-16">
    <div class="wrap max-w-3xl prose-content">
      <p>
        We are always interested in hearing from experienced cleaning operatives, supervisors and specialist technicians. If you hold relevant certifications such as BICSc, IPAF or rope access qualifications, we would like to hear from you.
      </p>
      <p>To enquire about current opportunities, contact us with your CV and area of interest.</p>
      <Button href="/contact-us/" class="mt-4">Get in Touch</Button>
    </div>
  </section>
</BaseLayout>
