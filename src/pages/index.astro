---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StatsBand from '../components/StatsBand.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SectorCard from '../components/SectorCard.astro';
import AccreditationStrip from '../components/AccreditationStrip.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Button from '../components/Button.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';

const services = (await getCollection('services'))
  .filter((s) => !s.data.parent)
  .sort((a, b) => a.data.order - b.data.order);

const sectors = (await getCollection('sectors')).sort((a, b) => a.data.order - b.data.order);

const locations = (await getCollection('locations')).sort((a, b) => a.data.order - b.data.order);

const title = 'Commercial Cleaning Company Ireland | Ryak Cleaning Dublin';
const description =
  'Specialist commercial and industrial cleaning across Ireland. Data centres, food production, healthcare and more. Dublin based, nationwide coverage. Call 01 531 4044.';

const reviewSchema = {
  '@type': 'Review',
  author: { '@type': 'Person', name: 'Gerard McAdorey', jobTitle: 'GM Marketing' },
  reviewBody:
    'I have used many cleaning companies over my years in business. Since I started my contract with Ryak Cleaning & Support Services I would not consider another service provider. Ryak are innovative around solutions, hardworking, punctual and the standard of work is second to none.',
  reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
  itemReviewed: { '@id': `${SITE.url}/#organization` },
};
---

<BaseLayout title={title} description={description} schema={[reviewSchema]}>
  <Hero
    title="Specialist commercial and industrial cleaning, everywhere in Ireland."
    description="From Dublin data centres to Cork food production lines, Ryak delivers audited, accredited cleaning and support services that keep Irish businesses compliant, safe and presentable. Family run for over 20 years."
  >
    <Fragment slot="title">
      Specialist commercial and industrial cleaning, <em class="text-red not-italic">everywhere in Ireland.</em>
    </Fragment>
  </Hero>

  <StatsBand />

  <section class="py-20">
    <div class="wrap">
      <SectionHead
        class="reveal"
        eyebrow="What We Do"
        title="Cleaning services built around Irish businesses"
        lead="One accredited contractor for every cleaning requirement, from daily contract cleaning to specialist industrial deep cleans, delivered on your schedule with minimal disruption."
      />
      <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
        {
          services.slice(0, 8).map((service) => (
            <div class="reveal">
              <ServiceCard
                title={service.data.title}
                description={service.data.description}
                href={`/services/${service.slug}/`}
                icon={service.data.icon}
                linkText={`${service.data.primaryKeyword} →`}
              />
            </div>
          ))
        }
      </div>
      <div class="mt-8 text-center reveal">
        <Button href="/services/">View all services</Button>
      </div>
    </div>
  </section>

  <section class="py-20 bg-ink text-white">
    <div class="wrap">
      <SectionHead
        class="reveal"
        eyebrow="Sectors We Serve"
        title="Specialist cleaning for Ireland's most demanding environments"
        lead="Every sector has its own compliance regime, access constraints and audit trail. Our teams are trained, vetted and equipped for each one."
        dark
      />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-3.5">
        {
          sectors.map((sector, i) => (
            <div class="reveal">
              <SectorCard
                title={sector.data.title}
                description={sector.data.description}
                href={`/sectors/${sector.slug}/`}
                index={i + 1}
                featured={sector.data.featured}
                tag={sector.data.featured ? 'Featured' : undefined}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="kitchen" class="py-20 bg-stone">
    <div class="wrap grid lg:grid-cols-2 gap-14 items-center">
      <div class="relative rounded-card overflow-hidden min-h-[380px] bg-gradient-to-br from-[#2A2C34] to-ink reveal">
        <img
          src="https://images.pexels.com/photos/2544829/pexels-photo-2544829.jpeg?auto=compress&cs=tinysrgb&w=1200"
          alt="Commercial kitchen ready for deep cleaning"
          width={1200}
          height={800}
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover"
        />
        <span class="absolute left-5 bottom-5 bg-red text-white font-display font-bold text-sm rounded-md px-4 py-2.5 shadow-lg">
          Certified deep cleans with compliance reports
        </span>
      </div>
      <div class="reveal">
        <SectionHead
          eyebrow="Spotlight Service"
          title="Commercial kitchen deep cleaning across Ireland"
        />
        <ul class="list-none grid gap-3 my-6">
          {
            [
              'Full deep kitchen cleans covering canopies, appliances, floors, walls and hard-to-reach areas',
              'TR19 grease extract and ductwork cleaning with before and after photographic evidence',
              'Certification for insurers, environmental health officers and fire risk assessments',
              'Out-of-hours and overnight scheduling for hotels, restaurants and staff canteens',
            ].map((item) => (
              <li class="flex gap-3 text-[15px] text-ink-soft">
                <svg class="w-5 h-5 flex-none mt-0.5 fill-red" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.5 14.5-4-4L8 11l2.5 2.5L16 8l1.5 1.5-7 7z" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
        <Button href="/services/commercial-kitchen-cleaning/">Book a Kitchen Deep Clean</Button>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="wrap">
      <SectionHead class="reveal" eyebrow="Why Choose Ryak" title="A contractor Irish facilities managers can stand over" />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          [
            {
              title: 'Accredited and auditable',
              text: 'ISO 9001 and ISO 14001 registered, SafeContractor approved and Constructionline Gold, with documented method statements and RAMS for every site.',
            },
            {
              title: 'Family run, directly employed',
              text: 'Over 20 years of family ownership. Our operatives are trained, vetted and directly employed, not subcontracted out of sight.',
            },
            {
              title: '24/7 emergency response',
              text: 'Fire, flood and oil spill response teams on call around the clock, anywhere on the island of Ireland.',
            },
            {
              title: 'Sector specific training',
              text: 'From cleanroom protocols in data centres to HACCP in food production, teams are trained for the environment they clean.',
            },
            {
              title: 'Modern equipment',
              text: 'Continually upgraded plant, from Doff stone cleaning systems to municipal road sweepers, delivering better results faster.',
            },
            {
              title: 'Responsive account management',
              text: 'A named contact, regular audits and quick answers. No call centres and no waiting a week for a quote.',
            },
          ].map((item) => (
            <div class="reveal bg-white border border-line rounded-card p-6">
              <h3 class="text-[16.5px] font-bold mb-2">{item.title}</h3>
              <p class="text-sm text-grey">{item.text}</p>
            </div>
          ))
        }
      </div>
      <AccreditationStrip />
    </div>
  </section>

  <section class="py-20 bg-stone">
    <div class="wrap grid lg:grid-cols-2 gap-14 items-center">
      <div class="reveal">
        <SectionHead
          eyebrow="Where We Work"
          title="Dublin based, covering all of Ireland"
          lead="Our Irish operation runs from Dublin with mobile specialist teams reaching every county. Northern Ireland clients are supported by our Belfast head office."
        />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-6">
          {
            locations.map((loc) => (
              <a
                href={`/locations/${loc.slug}/`}
                class="bg-white border border-line rounded-lg px-4 py-3.5 font-display font-bold text-[15px] flex items-center gap-2.5 hover:border-red transition-colors"
              >
                <svg class="w-4 h-4 fill-red flex-none" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z" />
                </svg>
                <div>
                  {loc.data.city}
                  <small class="block font-body font-normal text-xs text-grey">{loc.data.region}</small>
                </div>
              </a>
            ))
          }
        </div>
      </div>
      <div class="bg-ink rounded-card text-white p-10 relative overflow-hidden min-h-[340px] flex flex-col justify-end reveal">
        <span class="absolute top-[26%] right-[24%] w-4 h-4 bg-red rounded-full shadow-[0_0_0_8px_rgba(238,49,36,0.25)]" aria-hidden="true"></span>
        <h3 class="text-2xl font-bold relative">One island. One standard.</h3>
        <p class="text-[#B9BDC7] text-sm relative mt-2">
          With operations in Dublin and Belfast, Ryak is one of the few cleaning contractors that can hold a single quality standard across the whole island of Ireland, on one contract if you need it.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="wrap">
      <div class="bg-ink text-white rounded-card p-10 md:p-14 relative overflow-hidden reveal">
        <div class="text-red tracking-widest text-lg mb-4 relative" aria-label="Five star review">★★★★★</div>
        <blockquote class="font-display font-semibold text-[clamp(19px,2.3vw,25px)] leading-snug max-w-[840px] relative">
          I have used many cleaning companies over my years in business. Since I started my contract with Ryak Cleaning & Support Services I would not consider another service provider. Ryak are innovative around solutions, hardworking, punctual and the standard of work is second to none.
        </blockquote>
        <cite class="block mt-5 not-italic text-sm text-[#B9BDC7] relative">
          <b class="text-white font-display">Gerard McAdorey</b> · GM Marketing
        </cite>
      </div>
    </div>
  </section>

  <section class="py-20 bg-gradient-to-br from-red to-red-dark text-white">
    <div class="wrap grid lg:grid-cols-2 gap-14 items-center">
      <div class="reveal">
        <span class="eyebrow !text-white">Get a Quote</span>
        <h2 class="text-[clamp(28px,3.6vw,42px)] font-extrabold mt-3 mb-4">Tell us about your site. We will price it fast.</h2>
        <p class="text-[#FBD9D5] text-base">
          Send us a few details and a member of the team will come back with a tailored, no-obligation quotation. For urgent or emergency cleaning, call us directly.
        </p>
        <div class="grid gap-3 mt-6 font-display font-bold text-lg">
          <a href={SITE.phoneHref} class="flex items-center gap-2.5 hover:underline">
            <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z" />
            </svg>
            01 531 4044
          </a>
          <a href={`mailto:${SITE.email}`} class="flex items-center gap-2.5 hover:underline">
            <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" />
            </svg>
            {SITE.email}
          </a>
        </div>
      </div>
      <div class="reveal">
        <QuoteForm />
      </div>
    </div>
  </section>
</BaseLayout>
