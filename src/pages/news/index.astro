---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getCollection } from 'astro:content';
import { buildBreadcrumbs } from '../../utils/breadcrumbs';
---

<BaseLayout
  title="Resources & Insights | Ryak Cleaning Ireland"
  description="Commercial cleaning guides, TR19 advice and industry insights from Ryak Cleaning Ireland."
  breadcrumbs={buildBreadcrumbs([{ label: 'Resources', href: '/news/' }])}
>
  <section class="py-16 bg-stone">
    <div class="wrap">
      <SectionHead eyebrow="Resources" title="Guides and insights for Irish businesses" lead="Practical advice on kitchen extract cleaning, data centre standards and commercial cleaning best practice." />
    </div>
  </section>

  <section class="py-16">
    <div class="wrap grid gap-4 max-w-3xl">
      {
        (await getCollection('news'))
          .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
          .map((post) => (
            <a
              href={`/news/${post.slug}/`}
              class="block bg-white border border-line rounded-card p-6 hover:border-red transition-colors"
            >
              <time datetime={post.data.pubDate.toISOString()} class="text-xs text-grey uppercase tracking-wide">
                {post.data.pubDate.toLocaleDateString('en-IE', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
              <h2 class="text-xl font-bold mt-2 mb-2">{post.data.title}</h2>
              <p class="text-sm text-grey">{post.data.description}</p>
            </a>
          ))
      }
    </div>
  </section>
</BaseLayout>
