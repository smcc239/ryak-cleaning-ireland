---
import Button from './Button.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import type { BreadcrumbItem } from '../utils/breadcrumbs';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  imageSrc: string;
  imageAlt: string;
  breadcrumbs?: BreadcrumbItem[];
  compact?: boolean;
  dark?: boolean;
  primaryCta?: { label: string; href: string };
}

const {
  eyebrow,
  title,
  description,
  imageSrc,
  imageAlt,
  breadcrumbs,
  compact = false,
  dark = true,
  primaryCta,
} = Astro.props;
---

<section class="relative bg-ink text-white overflow-hidden min-h-[300px] md:min-h-[360px] flex items-stretch">
  <div class="absolute inset-0 min-h-[300px] md:min-h-[360px]">
    <ResponsiveImage src={imageSrc} alt={imageAlt} priority aspect="hero" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/45" aria-hidden="true"></div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent md:hidden"
      aria-hidden="true"
    >
    </div>
  </div>

  <div class:list={['wrap relative w-full z-10', compact ? 'py-12 md:py-14' : 'py-16 md:py-20']}>
    {breadcrumbs && breadcrumbs.length > 1 && <Breadcrumbs items={breadcrumbs} variant="inline" />}
    {eyebrow && <span class="eyebrow mt-2">{eyebrow}</span>}
    <h1
      class:list={[
        'font-black max-w-3xl leading-tight',
        compact ? 'text-[clamp(28px,4vw,44px)] mt-2 mb-3' : 'text-[clamp(34px,5vw,58px)] mt-3 mb-5',
      ]}
    >
      {title}
    </h1>
    {
      description && (
        <p class:list={['max-w-2xl text-[17px] leading-relaxed', dark ? 'text-white' : 'text-[#D4D7DE]']}>
          {description}
        </p>
      )
    }
    {
      primaryCta && (
        <Button href={primaryCta.href} class="mt-6">
          {primaryCta.label}
        </Button>
      )
    }
    <slot />
  </div>
</section>
