---
interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<details class="group border border-line rounded-lg bg-white">
  <summary class="font-display font-bold text-[16px] px-5 py-4 cursor-pointer list-none flex justify-between items-center gap-4">
    {question}
    <span class="text-red text-xl transition-transform group-open:rotate-45" aria-hidden="true">+</span>
  </summary>
  <div class="px-5 pb-4 text-grey text-[15px] leading-relaxed border-t border-line pt-4">
    <p>{answer}</p>
  </div>
</details>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
