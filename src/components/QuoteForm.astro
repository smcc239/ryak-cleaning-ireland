---
import Button from './Button.astro';
import { SITE } from '../consts';

interface Props {
  serviceOptions?: string[];
  compact?: boolean;
}

const {
  compact = false,
  serviceOptions = [
    'Contract / office cleaning',
    'Industrial or deep cleaning',
    'Commercial kitchen deep clean',
    'Ducting and ventilation',
    'Window cleaning',
    'Data centre cleaning',
    'Other / multiple services',
  ],
} = Astro.props;

/** Digits, spaces, +, brackets and hyphens (escaped so it is valid under the browser's `v` regex flag) */
const phonePattern = String.raw`[0-9+\(\)\- ]{7,20}`;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form class="form bg-white rounded-card p-8 text-ink shadow-2xl" action="/api/quote" method="POST">
  <h3 class="text-xl font-bold mb-1">Request a Free Quote</h3>
  <p class="text-xs text-grey mb-2"><span class="text-red" aria-hidden="true">*</span> Required fields</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <div>
      <label for="firstName" class="block text-xs font-semibold text-grey mt-3 mb-1">First name<span class="text-red" aria-hidden="true"> *</span></label>
      <input id="firstName" name="firstName" type="text" required pattern=".*[^ ].*" autocomplete="given-name" placeholder="First name" class="form-input" />
    </div>
    <div>
      <label for="lastName" class="block text-xs font-semibold text-grey mt-3 mb-1">Last name<span class="text-red" aria-hidden="true"> *</span></label>
      <input id="lastName" name="lastName" type="text" required pattern=".*[^ ].*" autocomplete="family-name" placeholder="Last name" class="form-input" />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <div>
      <label for="phone" class="block text-xs font-semibold text-grey mt-3 mb-1">Phone<span class="text-red" aria-hidden="true"> *</span></label>
      <input id="phone" name="phone" type="tel" required pattern={phonePattern} title="Enter a valid phone number, for example 01 531 4044" autocomplete="tel" placeholder="Phone number" class="form-input" />
    </div>
    <div>
      <label for="email" class="block text-xs font-semibold text-grey mt-3 mb-1">Email<span class="text-red" aria-hidden="true"> *</span></label>
      <input id="email" name="email" type="email" required autocomplete="email" placeholder="Email address" class="form-input" />
    </div>
  </div>

  <label for="service" class="block text-xs font-semibold text-grey mt-3 mb-1">Which service are you interested in?</label>
  <select id="service" name="service" required class="form-input">
    {serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
  </select>

  <label for="message" class="block text-xs font-semibold text-grey mt-3 mb-1">Message</label>
  <textarea id="message" name="message" rows={compact ? 2 : 3} placeholder="Tell us about your site and requirements" class="form-input"></textarea>

  {
    turnstileSiteKey && (
      <div class="cf-turnstile mt-4" data-sitekey={turnstileSiteKey} data-theme="light" />
    )
  }

  <label class="flex items-start gap-3 mt-4 cursor-pointer">
    <input
      type="checkbox"
      id="gdprConsent"
      name="gdprConsent"
      value="yes"
      required
      class="mt-1 w-4 h-4 accent-red shrink-0"
    />
    <span class="text-[12px] text-grey leading-relaxed">
      I consent to Ryak Cleaning and Support Services processing my personal data to respond to this enquiry, in
      accordance with the{' '}
      <a href="/privacy-policy/" class="text-red underline hover:text-red-dark">privacy policy</a>. I understand I can
      withdraw consent or request deletion of my data at any time by emailing{' '}
      <a href={`mailto:${SITE.email}`} class="text-red underline hover:text-red-dark">{SITE.email}</a>.
    </span>
  </label>

  <Button type="submit" variant="dark" class="quote-submit w-full mt-4 justify-center !border-0">Request a Quote</Button>
  <p class="text-xs text-grey text-center mt-3">We normally respond within 1 business day.</p>
</form>

{
  turnstileSiteKey && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<script>
  document.querySelectorAll<HTMLFormElement>('form[action="/api/quote"]').forEach((form) => {
    form.addEventListener('submit', () => {
      const button = form.querySelector<HTMLButtonElement>('.quote-submit');
      if (!button || button.disabled) return;
      button.textContent = 'Sending…';
      button.setAttribute('aria-disabled', 'true');
      // Disable after the submit event so the form data is still sent
      setTimeout(() => (button.disabled = true), 0);
    });
  });
</script>

<style>
  .form-input {
    @apply w-full border border-line rounded-md px-3 py-2.5 font-body text-sm bg-stone;
  }

  .form-input:focus {
    @apply outline-2 outline-red border-red bg-white;
  }

  .form-input:user-invalid {
    border-color: #ee3124;
    background-color: #fdf2f1;
  }

  .form-input:user-invalid:focus {
    outline-color: #ee3124;
  }

  .quote-submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }
</style>
