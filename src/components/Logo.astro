---
interface Props {
  class?: string;
  variant?: 'default' | 'footer';
}

const { class: className = '', variant = 'default' } = Astro.props;

/** Official Ryak wordmark — 290×97 source asset */
const src = '/images/ryak-logo.webp';
const width = 290;
const height = 97;

const defaultClass =
  variant === 'footer'
    ? 'h-[52.5px] w-auto max-w-[220px] object-left object-contain block'
    : 'h-[65.625px] w-auto max-w-[196px] object-left object-contain block';
---

<img
  src={src}
  alt="Ryak Cleaning and Support Services"
  width={width}
  height={height}
  class:list={[defaultClass, className]}
  loading="eager"
  decoding="async"
/>
