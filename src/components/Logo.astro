---
interface Props {
  class?: string;
  variant?: 'default' | 'footer';
}

const { class: className = '', variant = 'default' } = Astro.props;

const isFooter = variant === 'footer';
const src = isFooter ? '/images/ryak-logo-footer.png' : '/images/ryak-logo.webp';
const width = isFooter ? 245 : 476;
const height = isFooter ? 87 : 160;
const defaultClass = isFooter
  ? 'h-[52.5px] w-auto max-w-[220px] object-left object-contain block'
  : 'h-[65.625px] w-auto max-w-[194px] object-left object-cover block';
---

<img
  src={src}
  alt="Ryak Cleaning and Support Services"
  width={width}
  height={height}
  class:list={[defaultClass, className]}
  loading="eager"
  decoding="async"
/>
