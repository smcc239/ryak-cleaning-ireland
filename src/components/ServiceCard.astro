---
interface Props {
  title: string;
  description: string;
  href: string;
  linkText?: string;
  icon?: string;
}

const { title, description, href, linkText, icon = 'contract' } = Astro.props;

const icons: Record<string, string> = {
  contract: 'M4 21h16M6 21V8l6-4 6 4v13M10 21v-6h4v6',
  industrial: 'M3 20h18M5 20V9h5v11M14 20V4h5v16',
  kitchen: 'M4 15h16v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3zM7 15V9m5 6V6m5 9v-4',
  duct: 'M3 8h18M3 12h18M3 16h18M6 4v16m12-16v16',
  window: 'M5 3h14v18H5zM9 3v18m6-18v18',
  power: 'M4 20 20 4M14 4h6v6M4 14v6h6',
  floor: 'M3 17h18v4H3zM6 17V7l6-3 6 3v10',
  road: 'M3 17h13l4-6h-6l-3-5H7L5 11H3zM7 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm10 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  builders: 'M3 21h18M5 21V9l7-6 7 6v12M9 21v-5h6v5',
  emergency: 'M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3z',
  office: 'M4 21V8l5 3V8l5 3V8l6 4v9H4zM8 21v-4h3v4',
};
---

<article class="bg-white border border-line rounded-card p-6 flex flex-col gap-2.5 transition-all hover:border-red hover:-translate-y-1 hover:shadow-lg">
  <div class="w-11 h-11 rounded-lg bg-red-tint grid place-items-center mb-1">
    <svg class="w-[22px] h-[22px] stroke-red fill-none stroke-[1.8]" viewBox="0 0 24 24" aria-hidden="true">
      <path d={icons[icon] ?? icons.contract} stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </div>
  <h3 class="text-[19px] font-bold">{title}</h3>
  <p class="text-sm text-grey flex-1">{description}</p>
  <a href={href} class="font-display font-bold text-[13.5px] text-red hover:text-red-dark transition-colors">
    {linkText ?? `${title} →`}
  </a>
</article>
