---
import { STATS } from '../consts';
---

<div class="bg-red text-white">
  <div class="wrap grid grid-cols-2 lg:grid-cols-4">
    {
      STATS.map((stat, i) => (
        <div
          class:list={[
            'py-6 pr-6',
            i > 0 && 'lg:border-l lg:border-white/30 lg:pl-6',
            i % 2 === 1 && 'border-l border-white/30 pl-6 lg:border-l lg:pl-6',
          ]}
        >
          <b class="block font-display font-black text-[34px] leading-none">{stat.value}</b>
          <span class="text-[13.5px] opacity-90">{stat.label}</span>
        </div>
      ))
    }
  </div>
</div>
