---
import { SITE } from '../consts';
---

<div class="bg-ink text-[#C9CCD4] text-[13.5px]">
  <div class="wrap flex justify-between items-center min-h-[38px] gap-4">
    <div class="flex gap-5">
      <a href={SITE.phoneHref} class="inline-flex items-center gap-1.5 text-white font-semibold hover:text-red transition-colors">
        <svg class="w-3.5 h-3.5 fill-red" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"></path>
        </svg>
        01 531 4044
      </a>
      <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-1.5 text-white font-semibold hover:text-red transition-colors">
        <svg class="w-3.5 h-3.5 fill-red" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"></path>
        </svg>
        {SITE.email}
      </a>
    </div>
    <div class="hidden md:block text-[#9AA0AC]">Dublin based · Nationwide coverage across the island of Ireland</div>
  </div>
</div>
