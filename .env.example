# Copy to .env.local for local development (never commit secrets)

# Google Analytics 4 (optional)
PUBLIC_GA4_ID=
PUBLIC_GSC_VERIFICATION=

# Cloudflare Turnstile (optional spam protection)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mailgun — quote form emails (EU region)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.ryakcleaning.ie
QUOTE_TO_EMAIL=info@ryakcleaning.ie
